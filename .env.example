POSTGRES_DB=fsp
POSTGRES_USER=fsp
POSTGRES_PASSWORD=change-this-local-password
DJANGO_SECRET_KEY=change-this-long-random-secret
DJANGO_DEBUG=1
DEMO_SEED_ENABLED=1
DEMO_ENVIRONMENT=local
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional services are independent of the mandatory workflows.
FSP_PUBLIC_URL=http://127.0.0.1:3000
FSP_OIDC_ENABLED=0
FSP_OIDC_ISSUER=http://127.0.0.1:8000
FSP_OIDC_PRIVATE_KEY_FILE=
INTEGRATION_ENCRYPTION_KEY=
FSP_WEBHOOK_HOSTS=
FSP_WEBHOOK_ALLOW_LOOPBACK=0
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
